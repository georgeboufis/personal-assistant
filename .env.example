# Αντιγραψε αυτο το αρχειο σε .env και συμπληρωσε τις πραγματικες τιμες.
# Το .env ΔΕΝ πρεπει ποτε να μπει σε git (βαλε το στο .gitignore).

# --- Gemini API (δωρεαν tier) ---
# Παρε το key σου δωρεαν απο: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your_gemini_api_key_here

# Ποιο μοντελο Gemini να χρησιμοποιειται.
# gemini-3.6-flash = σταθερο, δοκιμασμενο Flash μοντελο, καλη επιλογη
# για agentic tool-calling. Το gemini-3.7-flash ειναι πιο προσφατο/δυνατο
# αλλα η οικογενεια Gemini 3.x εχει αλλαγες στο API schema (π.χ.
# thinking_level αντι για thinking_budget) που ισως δεν υποστηριζονται
# ακομα πληρως απο το pinned version του langchain-google-genai.
GEMINI_MODEL=gemini-3.6-flash

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# --- Google OAuth (για Calendar / Gmail) ---
# Αυτα τα παιρνεις απο το Google Cloud Console (OAuth 2.0 Client ID),
# ειναι δωρεαν, δεν σχετιζονται με το Gemini API key.
GOOGLE_OAUTH_CLIENT_ID=your_oauth_client_id_here
GOOGLE_OAUTH_CLIENT_SECRET=your_oauth_client_secret_here
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:8000/auth/callback

# --- App settings ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Logging ---
# Γραφει σε logs/assistant.log, με αυτοματη περιστροφη (max ~8MB συνολικα).
# Απαραιτητο για να βλεπεις τι εγινε στην πρωινη ενημερωση των 08:30, οταν
# δεν κοιτας το terminal.
LOG_TO_FILE=true
# ΠΡΟΣΟΧΗ: με true, γραφονται στον δισκο αποσπασματα απο τα μηνυματα και τα
# email σου. Χρησιμοποιησε το μονο προσωρινα για debugging.
LOG_CONTENT=false

# --- Πρωινη ενημερωση ---
# Τρεχει αυτοματα στην ωρα που οριζεις (ωρα Ελλαδας), εφοσον ο server
# ειναι ανοιχτος. Αν ηταν κλειστος, δημιουργειται on-demand οταν ανοιξεις
# το UI - οποτε δεν τη χανεις.
BRIEFING_ENABLED=true
BRIEFING_HOUR=8
BRIEFING_MINUTE=30
# Αν true, σου στελνει την ενημερωση και με email (στη δικη σου διευθυνση).
BRIEFING_SEND_EMAIL=true
